+using System.Collections.Generic;
+using System.Windows.Forms;
+using SensitivityFinder;
+static class AccuracyUiTests {
+    static IEnumerable<Control> All(Control c){foreach(Control child in c.Controls){yield return child;foreach(var nested in All(child))yield return nested;}}
+    [STAThread]static int Main(string[] args){try{Application.EnableVisualStyles();Application.SetCompatibleTextRenderingDefault(false);Directory.CreateDirectory(args[0]);
+        foreach(var size in new[]{new Size(620,650),new Size(820,790)})using(var form=new CalibrationForm(new Setup())) {
+            form.Size=size;form.ShowInTaskbar=false;form.StartPosition=FormStartPosition.Manual;form.Location=new Point(-10000,-10000);form.Show();Application.DoEvents();form.PerformLayout();
