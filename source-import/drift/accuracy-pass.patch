+    // Bounded-memory histogram. Values are upper bin edges, not precise timestamps.
+    public sealed class TimingHistogram {
+        public int[] Bins=new int[2001];
+        public int Count,Invalid;
+        public double MaximumMs,TotalMs;
+        public void Add(double ms) {
+            if(!MathUtil.Finite(ms) || ms<=0){Invalid++;return;}
+            Count++;TotalMs+=ms;MaximumMs=Math.Max(MaximumMs,ms);
+            int bin=(int)Math.Min(2000,Math.Ceiling(ms/.05));Bins[bin]++;
+        }
+        public double Percentile(double fraction) {
+            if(Count==0)return 0;
+            int rank=(int)Math.Ceiling(Math.Max(0,Math.Min(1,fraction))*Count),seen=0;
+            for(int i=0;i<Bins.Length;i++){seen+=Bins[i];if(seen>=Math.Max(1,rank))return i==2000?MaximumMs:i*.05;}
+            return MaximumMs;
+        }
+    }
+    public sealed class InputTimingEvidence {
