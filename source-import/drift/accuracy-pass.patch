new file mode 100644
index 0000000..8bf203a
--- /dev/null
+++ b/src/DriverParityChecks.cs
@@ -0,0 +1,42 @@
+using System;
+using System.IO;
+using System.Linq;
+using System.Collections.Generic;
+using SensitivityFinder;
+// Read-only official calculator. No Activate/GetActive/writer calls.
+static class DriverParityChecks {
+    static int checks;
+    static void Compare(Candidate c,string template) {
+        var config=DriverConfig.Convert(Storage.Json().Serialize(Storage.ProfileJson(template,c)));
+        if(config.Item2!=null)throw new Exception("Official calculator rejected the export: "+config.Item2);
+        try {
+            foreach(var xy in new[]{new[]{1000,0},new[]{0,1000},new[]{600,800},new[]{-600,800},new[]{600,-800},new[]{-600,-800}})
+            foreach(double speed in new[]{.001,.01,.1,1,2.999,3,3.001,5,12,24,48,100,500,1000}) {
+                var actual=config.Item1.accels[0].Accelerate(xy[0],xy[1],1,1000/speed);
+                var expected=c.Transform(xy[0],xy[1],speed);
+                double tolerance=1e-6*Math.Max(1,Math.Max(Math.Abs(expected[0]),Math.Abs(expected[1])));
+                if(Math.Abs(actual.Item1-expected[0])>tolerance || Math.Abs(actual.Item2-expected[1])>tolerance)throw new Exception("Calculator mismatch: "+c.CurveKind+" / speed "+speed+" / Y "+c.YRatio);
+                checks++;
+            }
+        } finally {foreach(var accel in config.Item1.accels)accel.Dispose();}
+    }
+    static int Main(string[] args){try{
+        string installed=System.Diagnostics.FileVersionInfo.GetVersionInfo(Path.Combine(AppDomain.CurrentDomain.BaseDirectory,"rawaccel.exe")).FileVersion;
+        if(installed!="1.6.1")throw new Exception("Only installed Raw Accel 1.6.1 is validated; found "+installed);
+        string template=File.ReadAllText(args[0]);
+        foreach(string mode in new[]{"constant","natural","classic","lut"})foreach(double y in new[]{.5,1,1.5,2}) {
+            var c=new Candidate{Id="synthetic",Stage="parity",CurveKind=mode=="constant"?"natural":mode,BaseGain=.8,YRatio=y,Limit=mode=="constant"?1:1.5,Offset=3,Decay=.04,Acceleration=.02};
+            if(mode=="lut")c.Points=new List<CurvePoint>{new CurvePoint(.0001,.0001),new CurvePoint(3,3),new CurvePoint(12,15),new CurvePoint(24,36),new CurvePoint(48,72)};
+            Compare(c,template);
+            foreach(int dpi in new[]{800,1600,3200}) {
+                var derived=DpiMatching.Rescale(c,2000,dpi,MathUtil.Cm360(2000,.45,.022,c.BaseGain),.45,.022);
+                Compare(derived,template);
+                foreach(double speed in new[]{.01,1,3,12,48,200}) {
+                    double before=c.Multiplier(speed)/c.BaseGain,after=derived.Multiplier(speed*dpi/2000)/derived.BaseGain;
+                    if(Math.Abs(before-after)>1e-5*Math.Max(1,before))throw new Exception("DPI transfer changed physical-speed shape");checks++;
+                }
+            }
+        }
+        Console.WriteLine("PASS "+checks+" official 1.6.1 calculator / direction / Y / DPI comparisons. Synthetic only. Live driver behavior NOT RUN; no driver writes.");return 0;
+    }catch(Exception e){Console.Error.WriteLine(e);return 1;}}
+}
