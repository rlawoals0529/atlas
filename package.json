{
  "name": "atlas",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "node scripts/validate-ui-encoding.mjs && tsc -b && vite build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "data:seed": "node scripts/generate-seed.mjs",
    "data:report": "node scripts/data-report.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "community:validate": "node scripts/validate-community-insights.mjs",
    "sensitivity:validate": "node scripts/validate-sensitivity.mjs",
    "product:validate": "node scripts/validate-product-lab.mjs",
    "media:validate": "node scripts/validate-product-media.mjs",
    "switch-index:validate": "node scripts/validate-switch-review-index.mjs",
    "a11y:validate": "node scripts/validate-modal-accessibility.mjs",
    "bundle:validate": "node scripts/validate-bundle-budget.mjs",
    "verify": "npm run test && npm run sbom:generate && npm run release:validate && npm run data:validate && npm run community:validate && npm run sensitivity:validate && npm run product:validate && npm run media:validate && npm run switch-index:validate && npm run scores:validate && npm run a11y:validate && npm run headers:validate && npm run public:validate && npm run check && npm run bundle:validate",
    "source:check": "node scripts/check-source-health.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "release:validate": "node scripts/validate-release-contract.mjs",
    "headers:validate": "node scripts/validate-static-headers.mjs",
    "public:validate": "node scripts/validate-public-metadata.mjs",
    "dev:ui": "vite --config vite.ui.config.ts",
    "scores:generate": "node scripts/generate-switch-scores.mjs",
    "scores:validate": "node scripts/generate-switch-scores.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "hono": "4.13.11",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@types/node": "26.6.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": "22.x"
  }
}
