{
  "name": "atlas",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b && vite build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "data:seed": "node scripts/generate-seed.mjs",
    "data:report": "node scripts/data-report.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "community:validate": "node scripts/validate-community-insights.mjs",
    "sensitivity:validate": "node scripts/validate-sensitivity.mjs",
    "product:validate": "node scripts/validate-product-lab.mjs",
    "media:validate": "node scripts/validate-product-media.mjs",
    "switch-index:validate": "node scripts/validate-switch-review-index.mjs",
    "a11y:validate": "node scripts/validate-modal-accessibility.mjs",
    "bundle:validate": "node scripts/validate-bundle-budget.mjs",
    "verify": "npm run test && npm run sbom:generate && npm run data:validate && npm run community:validate && npm run sensitivity:validate && npm run product:validate && npm run media:validate && npm run switch-index:validate && npm run a11y:validate && npm run check && npm run bundle:validate",
    "source:check": "node scripts/check-source-health.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "sbom:generate": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "hono": "4.13.11",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "wrangler": "4.136.1",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": "22.x"
  }
}
